typedef int... size_t;
typedef _Bool bool;

typedef struct Session Session;
typedef struct History History;
typedef struct HistoryEntry HistoryEntry;
typedef struct Trie Trie;
typedef struct DirStack DirStack;
typedef struct Terminal Terminal;
typedef struct Environ Environ;
typedef struct Array Array;
typedef struct Redirection Redirection;
typedef struct LexerInput LexerInput;
typedef struct ASTNode ASTNode;
typedef struct Jobs Jobs;
typedef struct Job Job;
typedef struct Features Features;
typedef struct ConditionalBranch ConditionalBranch;

typedef enum CommandType {
    COMMAND_NOT_FOUND,
    COMMAND_ALIAS,
    COMMAND_BUILTIN,
    COMMAND_SPECIAL_BUILTIN,
    COMMAND_EXTERNAL,
    COMMAND_FUNCTION
} CommandType;

typedef struct CommandInfo {
    CommandType type;
    char       *path;
} CommandInfo;

struct Array {
    char **items;
    size_t count;
    size_t capacity;
    size_t (*growing_strategy)(size_t, size_t);
    ...;
};

struct HistoryEntry {
    char                *command;
    long                 timestamp;
    struct HistoryEntry *next;
    struct HistoryEntry *prev;
    ...;
};

struct History {
    HistoryEntry *head;
    HistoryEntry *tail;
    size_t        size;
    ...;
};

struct DirStack {
    Array *stack;
    ...;
};

struct Features {
    bool variable_expansion;
    bool tilde_expansion;
    bool brace_expansion;
    bool filename_expansion;
    bool alias_expansion;
    bool arithmetic_expansion;
    bool job_control;
    bool history;
    bool directory_stack;
    bool prompt_expansion;
    bool completion;
    bool pipes;
    bool redirections;
    bool sequences;
    bool subshells;
    bool blocks;
    bool command_substitution;
    bool assignments;
    bool functions;
    bool context_managers;
    ...;
};

typedef struct ShellOptions ShellOptions;
struct ShellOptions {
    bool allexport;
    bool errexit;
    bool noglob;
    bool nounset;
    bool verbose;
    bool xtrace;
    bool noexec;
    bool noclobber;
    bool monitor;
    bool pipefail;
    ...;
};

struct Session {
    char     *current_working_dir;
    char     *previous_working_dir;
    Environ  *environ;
    History  *history;
    Trie     *aliases;
    Trie     *functions;
    Trie     *path_commands;
    DirStack *dirstack;
    Terminal *terminal;
    Jobs     *jobs;
    Features     features;
    ShellOptions options;
    bool         exit_requested;
    bool         hooks_disabled;
    ...;
};

struct Terminal {
    size_t rows;
    size_t cols;
    bool   supports_colors;
    ...;
};

// Session
Session *init_session(Session *session, char *history_path);
void update_working_dir(Session *session);
void update_path(Session *session);
void free_session(Session *session);

// Features
Features *init_features(Features *features);
Features *init_features_minimal(Features *features);
void features_enable_all_expansions(Features *features);
void features_disable_all_expansions(Features *features);

// Execution
int execute_string(const char *cmd, Session *session);
char *execute_string_stdout(const char *cmd, Session *session);
char *find_in_path(const char *cmd, Session *session);
CommandInfo get_command_info(const char *cmd, Session *session);

// Environment
Environ *init_environ(Environ *env);
char *environ_get(Environ *env, char *key);
void environ_set(Environ *env, char *key, char *value);
bool environ_contains(Environ *env, char *key);
char *environ_get_default(Environ *env, char *key, char *default_value);
Environ *environ_copy(Environ *src, Environ *dest);
Array *environ_to_array(Environ *env);
bool environ_remove(Environ *env, char *key);
void free_environ(Environ *env);

// Array
void free_array(Array *array);

// History
History *init_history(History *history);
History *load_history(History *history, char *filepath);
void history_clear(History *history);
void history_save(History *history);
bool history_remove(History *history, const char *command, bool all);
void history_append(History *history, const char *command);
char *history_get_next(History *history);
char *history_get_previous(History *history);
char *history_last_command(History *history);
char *history_nth_command(History *history, size_t n);
void free_history(History *history);

// Trie (for aliases)
char *trie_get(Trie *trie, char *key);
bool trie_set(Trie *trie, char *key, char *value);
bool trie_contains(Trie *trie, char *key);
bool trie_delete_key(Trie *trie, char *key);
Array *trie_starting_with(Trie *trie, char *prefix);

// DirStack
bool dirstack_pushd(DirStack *directory_stack, const char *path);
bool dirstack_popd(DirStack *directory_stack);
char *dirstack_peek(const DirStack *directory_stack, size_t n);

// Expansions
Array *full_expansion(char *input, Session *session);

// Lexer
typedef enum TokenType {
    TOKEN_WORD,
    TOKEN_COMMENT,
    TOKEN_IO_NUMBER,
    TOKEN_ASSIGNMENT,
    TOKEN_PIPE,
    TOKEN_REDIRECT_IN,
    TOKEN_FD_DUPLICATION,
    TOKEN_HEREDOC,
    TOKEN_HERESTRING,
    TOKEN_REDIRECT_OUT,
    TOKEN_REDIRECT_APPEND,
    TOKEN_REDIRECT_OUT_ERR,
    TOKEN_REDIRECT_ALL,
    TOKEN_REDIRECT_APPEND_ERR,
    TOKEN_PROCESS_SUBSTITUTION_IN,
    TOKEN_PROCESS_SUBSTITUTION_OUT,
    TOKEN_BACKGROUND,
    TOKEN_SEQUENCE,
    TOKEN_OR,
    TOKEN_SEMICOLON,
    TOKEN_LPAREN,
    TOKEN_RPAREN,
    TOKEN_LBRACE,
    TOKEN_RBRACE,
    TOKEN_IF,
    TOKEN_THEN,
    TOKEN_ELSE,
    TOKEN_ELIF,
    TOKEN_FI,
    TOKEN_CASE,
    TOKEN_ESAC,
    TOKEN_DOUBLE_SEMICOLON,
    TOKEN_CASE_FALLTHROUGH,
    TOKEN_CASE_CONTINUE,
    TOKEN_FOR,
    TOKEN_WHILE,
    TOKEN_IN,
    TOKEN_DO,
    TOKEN_DONE,
    TOKEN_EOL,
    TOKEN_EOF
} TokenType;

typedef struct LexerToken {
    TokenType type;
    char *value;
    char *extra;
    ...;
} LexerToken;

LexerInput *init_lexer_input(LexerInput *input, char *data, void *execute_fn, Session *session);
LexerToken lexer_next_token(LexerInput *input);
void free_lexer_token(LexerToken *token);
void free_lexer_input(LexerInput *input);
const char *token_type_to_string(TokenType type);

// Parser
typedef enum NodeType {
    NODE_COMMAND,
    NODE_PIPE,
    NODE_AND,
    NODE_OR,
    NODE_SEQUENCE,
    NODE_SUBSHELL,
    NODE_BLOCK,
    NODE_CONDITIONAL,
    NODE_CASE,
    NODE_FUNCTION_DEF,
    NODE_FOR,
    NODE_WHILE,
    NODE_UNTIL,
    NODE_WITH
} NodeType;

struct ConditionalBranch {
    struct ASTNode *condition;
    struct ASTNode *body;
    struct ConditionalBranch *next;
    ...;
};

typedef enum CaseTerminator {
    CASE_TERM_BREAK,
    CASE_TERM_FALLTHROUGH,
    CASE_TERM_CONTINUE
} CaseTerminator;

typedef struct CaseItem {
    char **patterns;
    int pattern_count;
    struct ASTNode *body;
    CaseTerminator terminator;
    struct CaseItem *next;
    ...;
} CaseItem;

struct Redirection {
    int                 fd;
    TokenType           type;
    char               *target;
    bool                is_process_substitution;
    struct Redirection *next;
    ...;
};

struct ASTNode {
    NodeType type;
    char **argv;
    int *arg_is_sub;
    int argc;
    Redirection *redirects;
    Array *assignments;
    struct ASTNode *left;
    struct ASTNode *right;
    bool background;
    ConditionalBranch *branches;
    CaseItem *case_items;
    bool for_has_in;
    ...;
};

ASTNode *parse(LexerInput *lexer, Session *session);
void free_ast(ASTNode *node);
const char *node_type_to_string(NodeType type);

// Job control
typedef enum JobState {
    JOB_RUNNING,
    JOB_STOPPED,
    JOB_DONE,
    JOB_KILLED
} JobState;

struct Job {
    int      id;
    int      pid;
    char    *command;
    JobState state;
    int      exit_status;
    bool     notified;
    ...;
};

struct Jobs {
    Job  *jobs;
    int   count;
    int   capacity;
    int   pgid;
    ...;
};

Jobs *init_jobs(void);
int jobs_add(Jobs *jobs, int pid, char *command, JobState state);
Job *jobs_get(Jobs *jobs, int job_id);
Job *jobs_get_by_pid(Jobs *jobs, int pid);
bool jobs_remove(Jobs *jobs, int job_id);
Job *jobs_get_current(Jobs *jobs);
Job *jobs_get_previous(Jobs *jobs);
void jobs_update(Jobs *jobs);
void jobs_notify(Jobs *jobs);
void free_jobs(Jobs *jobs);

// Builtins
int builtin_cd(int argc, char **argv, Session *session);
int builtin_set(int argc, char **argv, Session *session);

extern const char *tidesh_compiler;

// Hooks
typedef struct HookEnvVar {
    const char *key;
    const char *value;
} HookEnvVar;

void run_cwd_hook(Session *session, const char *hook_name);
void run_cwd_hook_with_vars(Session *session, const char *hook_name,
                            const HookEnvVar *vars, size_t var_count);

// Session Snapshot
typedef struct SessionSnapshot SessionSnapshot;
SessionSnapshot *session_snapshot_create(Session *session);
void session_snapshot_restore(Session *session, SessionSnapshot *snapshot);
void session_snapshot_free(SessionSnapshot *snapshot);

// General free
void free(void *ptr);
